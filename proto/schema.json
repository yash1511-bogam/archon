{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Tier": {
      "type": "string",
      "enum": ["simple", "standard", "complex"]
    },
    "Step": {
      "type": "object",
      "required": ["id", "model", "tier", "input_tokens", "output_tokens", "cost_usd", "latency_ms", "cached", "timestamp"],
      "properties": {
        "id": { "type": "string" },
        "model": { "type": "string" },
        "tier": { "$ref": "#/definitions/Tier" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "tool_call": { "type": ["string", "null"] },
        "cached": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "BudgetConfig": {
      "type": "object",
      "properties": {
        "max_per_run": { "type": ["number", "null"], "minimum": 0 },
        "max_per_day": { "type": ["number", "null"], "minimum": 0 },
        "max_per_month": { "type": ["number", "null"], "minimum": 0 },
        "warn_at": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
      }
    },
    "RoutingDecision": {
      "type": "object",
      "required": ["tier", "model", "reason"],
      "properties": {
        "tier": { "$ref": "#/definitions/Tier" },
        "model": { "type": "string" },
        "reason": { "type": "string" },
        "fallback": { "type": ["string", "null"] }
      }
    }
  }
}
